# Copy this file to .env and add your Formspree form endpoints.
# .env is gitignored and must never be committed.
# Create a free form at https://formspree.io, then paste its URL (https://formspree.io/f/xxxxxx).
# Forms still work locally without these values: requests are saved in localStorage only.
VITE_FORMSPREE_RESERVATION_ENDPOINT=
VITE_FORMSPREE_ROOM_ENQUIRY_ENDPOINT=
VITE_FORMSPREE_CONTACT_ENDPOINT=

# Optional: used by the image fetcher (node scripts/fetch-images.mjs).
PIXABAY_API_KEY=
