# Copy this file to .env. .env is gitignored and must never be committed.

# Application environment variables (exposed to the browser by Vite).
# Create a free form at https://formspree.io and paste its URL here.
# All three forms (table reservation, room enquiry, contact) use this one endpoint:
VITE_FORMSPREE_ENDPOINT=

# Build-time only: used by node scripts/fetch-images.mjs, NOT by the deployed app.
# The API key is read from .env by the script and is never bundled into the site.
PIXABAY_API_KEY=
